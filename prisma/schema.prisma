generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum SlotStatus {
  AVAILABLE
  BLOCKED
  BOOKED
}

enum BookingStatus {
  PENDING
  QUOTE_PROVIDED
  CONFIRMED
  RESCHEDULE_REQUESTED
  RESCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer     Customer?

  @@map("users")
}

model Customer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @unique @map("user_id") @db.Uuid
  fullName     String   @map("full_name")
  phone        String?
  email        String
  addressLine1 String?  @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  city         String?
  postcode     String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User?    @relation(fields: [userId], references: [id])
  bookings     Booking[]

  @@map("customers")
}

model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String   @unique
  shortDescription String? @map("short_description")
  description     String?
  category        String?
  priceType       String   @default("FROM_PRICE") @map("price_type")
  basePrice       Decimal  @map("base_price") @db.Decimal(10, 2)
  durationMinutes Int      @default(120) @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  imageUrl        String?  @map("image_url")
  icon            String?  @default("Sparkles")
  features        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bookings        Booking[]

  @@map("services")
}

model AvailabilitySlot {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date      DateTime   @db.Date
  startTime DateTime   @map("start_time") @db.Time
  endTime   DateTime   @map("end_time") @db.Time
  status    SlotStatus @default(AVAILABLE)
  notes     String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  bookings  Booking[]

  @@unique([date, startTime, endTime])
  @@map("availability_slots")
}

model Booking {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingReference   String           @unique @map("booking_reference")
  customerId         String           @map("customer_id") @db.Uuid
  serviceId          String           @map("service_id") @db.Uuid
  availabilitySlotId String           @map("availability_slot_id") @db.Uuid
  
  serviceAddress     String?          @map("service_address")
  serviceCity        String?          @map("service_city")
  servicePostcode    String?          @map("service_postcode")
  
  propertyType       String?          @map("property_type")
  numberOfFloors     Int?             @map("number_of_floors")
  windowCount        Int?             @map("window_count")
  accessNotes        String?          @map("access_notes")
  customerNotes      String?          @map("customer_notes")
  
  appointmentDate    DateTime         @map("appointment_date") @db.Date
  startTime          DateTime         @map("start_time") @db.Time
  endTime            DateTime         @map("end_time") @db.Time
  
  status             BookingStatus    @default(PENDING)
  
  subtotal           Decimal          @default(0) @db.Decimal(10, 2)
  discount           Decimal          @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal          @default(0) @map("total_amount") @db.Decimal(10, 2)
  depositAmount      Decimal          @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  remainingAmount    Decimal          @default(0) @map("remaining_amount") @db.Decimal(10, 2)
  
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  customer           Customer         @relation(fields: [customerId], references: [id])
  service            Service          @relation(fields: [serviceId], references: [id])
  availabilitySlot   AvailabilitySlot @relation(fields: [availabilitySlotId], references: [id])
  bookingHistory     BookingHistory[]

  @@map("bookings")
}

model BookingHistory {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  oldStatus   BookingStatus? @map("old_status")
  newStatus   BookingStatus  @map("new_status")
  changedBy   String?        @map("changed_by")
  reason      String?
  createdAt   DateTime       @default(now()) @map("created_at")

  booking     Booking        @relation(fields: [bookingId], references: [id])

  @@map("booking_history")
}

model SiteSettings {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessName      String   @default("British Prestige Cleaning Solutions") @map("business_name")
  phone             String?
  email             String?
  whatsapp          String?
  address           String?
  openingHours      Json?    @map("opening_hours")
  cancellationHours Int      @default(24) @map("cancellation_hours")
  currency          String   @default("GBP")
  timezone          String   @default("Europe/London")
  bookingsEnabled   Boolean  @default(true) @map("bookings_enabled")
  coveredAreas      String?  @map("covered_areas")
  availableWindow   String?  @map("available_window")
  heroHeadline      String   @default("Professional Cleaning Services You Can Trust") @map("hero_headline")
  heroSubtitle      String   @default("Experience the difference with our expert cleaning team. We provide top-quality residential and commercial cleaning services tailored to your needs.") @map("hero_subtitle")

  @@map("site_settings")
}
